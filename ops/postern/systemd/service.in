# Generated by postern.serve install; review changes before replacing an existing unit.
[Unit]
Description=$description
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=$user
WorkingDirectory=$root
Environment=$home
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
Environment="PYTHONWARNINGS=ignore"
$environment
ExecStart=$command
Restart=always
RestartSec=5
# A watchdog SIGTERM must restart the API, including after a clean Uvicorn exit.
# Kill the whole service cgroup on stop so converter sessions cannot outlive it.
KillMode=control-group
TimeoutStopSec=150
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
