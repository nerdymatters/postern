{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bash dashboard/web/scripts/vercel-install.sh",
  "buildCommand": "bash dashboard/web/scripts/vercel-build.sh",
  "outputDirectory": "dashboard/web/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!assets/|legal/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/legal/terms/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
